# API
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# Solo lo usa el servidor web para reenviar /api. La API continúa cerrada en loopback.
INTERNAL_API_URL=http://127.0.0.1:4000

# PostgreSQL: reemplazar usuario y contraseña en cada instalación.
DATABASE_URL=postgresql://crm_app:change-me@127.0.0.1:5432/crm_localderopa?schema=public&connection_limit=10&pool_timeout=10

# Sesiones
SESSION_COOKIE_NAME=crm_session
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Imágenes optimizadas de productos. En producción se ubica fuera del código y se protege con ACL.
PRODUCT_IMAGES_DIR=C:\ProgramData\CRM-LocalDeRopa\images
BACKUP_STATUS_FILE=C:\ProgramData\CRM-LocalDeRopa\state\backup-status.json
