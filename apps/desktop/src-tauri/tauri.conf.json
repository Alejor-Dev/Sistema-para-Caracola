{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caracola",
  "version": "0.1.0",
  "identifier": "com.caracola.crm",
  "build": {
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "http://127.0.0.1:3000"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Caracola",
      "url": "http://127.0.0.1:3000",
      "width": 1440,
      "height": 940,
      "minWidth": 1024,
      "minHeight": 700,
      "center": true
    }],
    "security": { "capabilities": ["default"] }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Caracola",
    "shortDescription": "Gestión comercial, ventas e inventario",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "windows": {
      "nsis": { "displayLanguageSelector": false, "installMode": "perMachine" }
    }
  }
}
