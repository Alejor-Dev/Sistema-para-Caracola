<service>
  <id>CrmApi</id>
  <name>Caracola - API</name>
  <description>API local del sistema comercial.</description>
  <executable>%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe</executable>
  <arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;{{SERVICE_ROOT}}\Run-CrmApi.ps1&quot; -ConfigPath &quot;{{CONFIG_PATH}}&quot;</arguments>
  <workingdirectory>{{INSTALL_ROOT}}\current</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>{{POSTGRES_SERVICE}}</depend>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>{{DATA_ROOT}}\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>8</keepFiles></log>
</service>
